{
  "name": "dsh-ssh-shell",
  "description": "DSH plugin: password SSH into a remote host — a natural-language tool (connect/exec/close/status) over a persistent ControlMaster session, plus a browser terminal panel (right-side floating) with a real PTY over WebSocket.",
  "version": "0.7.3",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run_all.mjs",
    "pretest": "node scripts/link-host-deps.mjs || node -e \"console.error('\\n缺少宿主的 @deepseek-ai/dsh-tools。\\n请先运行: node scripts/link-host-deps.mjs --host <DSH安装目录>\\n'); process.exit(1)\"",
    "link-host-deps": "node scripts/link-host-deps.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.3.0"
  },
  "dependencies": {
    "node-pty": "^1.2.0-beta.15",
    "ws": "^8.0.0"
  },
  "license": "Apache-2.0",
  "author": "framecy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framecy/dsh-ssh-shell.git"
  },
  "bugs": {
    "url": "https://github.com/framecy/dsh-ssh-shell/issues"
  },
  "homepage": "https://github.com/framecy/dsh-ssh-shell#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ssh",
    "terminal",
    "controlmaster"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
